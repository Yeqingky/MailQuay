# Required / 必填
# base64 of 32 random bytes, e.g. `openssl rand -base64 32`. / 32 字节随机值的 base64.
MAILQUAY_SECRET_KEY=replace-with-base64-encoded-32-bytes
# Absolute public URL used for OAuth callbacks and cookies. / 用于 OAuth 回调和 Cookie 的绝对公开地址.
MAILQUAY_PUBLIC_URL=http://localhost:8080

# Database / 数据库
POSTGRES_USER=mailquay
POSTGRES_PASSWORD=mailquay
POSTGRES_DB=mailquay
# Only for running the binary outside compose. / 仅在脱离 compose 直接运行二进制时使用.
# MAILQUAY_DATABASE_URL=postgres://mailquay:mailquay@127.0.0.1:5432/mailquay?sslmode=disable

# Storage / 存储
MAILQUAY_DATA_DIR=./data
MAILQUAY_SEARCH_PATH=./data/search

# HTTP / HTTP
MAILQUAY_LISTEN_ADDR=:8080
# Comma-separated allowed CORS origins. / 允许的跨源来源, 逗号分隔.
MAILQUAY_CORS_ORIGINS=
# Comma-separated domains or CIDRs exempt from the HTTPS warning. / 免除非安全传输提醒的域名或 CIDR, 逗号分隔.
MAILQUAY_INSECURE_ALLOW=
# Comma-separated trusted proxy CIDRs. / 可信代理 CIDR, 逗号分隔.
MAILQUAY_TRUSTED_PROXIES=172.16.0.0/12

# Optional / 可选
# One-time setup token, at least 16 characters; generated into data/setup-token when empty. / 一次性 setup token, 至少 16 字符; 留空时生成到 data/setup-token.
MAILQUAY_SETUP_TOKEN=
MAILQUAY_LOG_LEVEL=info
MAILQUAY_LOG_FORMAT=text

# Production compose (docker-compose.yml) / 生产 compose
MAILQUAY_IMAGE_TAG=latest
MAILQUAY_WEB_PORT=8080

# Development compose only (docker-compose-dev.yml), commented by default. / 仅开发 compose 使用, 默认注释.
# MAILQUAY_API_PORT=127.0.0.1:8080
# MAILQUAY_VERSION=dev
# MAILQUAY_COMMIT=local
# MAILQUAY_BUILD_TIME=unknown
# MAILQUAY_DB_NAME=mailquay
